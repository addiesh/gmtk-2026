[node name="DialogueDataNode3" parent="." unique_id=868018504 instance=ExtResource("4_rbh7r")]
position = Vector2(2581, 1729)
rotation = 3.1415927
Dialogue_text = "I'll have to use what I can find. A hammer is perfect.

* [color=#ff5277]press [ RIGHT CLICK ] to pick up, again to throw towards your cursor[/color]"
Dialogue_image = ExtResource("5_aaho8")

[node name="DialogueDataNode4" parent="." unique_id=1811069345 instance=ExtResource("4_rbh7r")]
position = Vector2(3503, 1729)
Dialogue_text = "No matter what, I have the upper hand.

* [color=#ff5277]time moves when you move; try moving while your hammer is in midair.[/color]"
Dialogue_image = ExtResource("5_aaho8")

[node name="DialogueDataNode7" parent="." unique_id=618099339 instance=ExtResource("4_rbh7r")]
position = Vector2(4488, 1408)
Dialogue_text = "My equipment should let me zip around.

* [color=#ff5277]press [ SPACE ] to dash. Using your actions depletes time.[/color]"
Dialogue_image = ExtResource("5_aaho8")

[node name="DialogueDataNode5" parent="." unique_id=682074968 instance=ExtResource("4_rbh7r")]
position = Vector2(436, 1729)
Dialogue_text = "I won't stop until they tear me to shreds- and I won't let them.

* [color=#ff5277]press [ R ] to retry a level.[/color]"
Dialogue_image = ExtResource("5_aaho8")

