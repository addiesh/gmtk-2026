[sub_resource type="GDScript" id="GDScript_1hfnh"]
script/source = "extends Area2D

var enabled = true;

func _on_body_entered(body: Node2D) -> void:
	if body is Player && enabled:
		enabled = false;
		$AnimationPlayer.play(\"now_kiss\");
		$Lobster.play()
	
func _process(delta: float) -> void:
	$AnimationPlayer.speed_scale = 1.0 / Timekeeper.timescale();
"

