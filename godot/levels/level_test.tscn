[sub_resource type="Shader" id="Shader_5vw27"]
code = "shader_type canvas_item;
uniform sampler2D screen_tex : hint_screen_texture;
uniform float timescale;

varying vec4 simptons;

void vertex() {
	simptons = COLOR;
}

void fragment() {
	vec4 col = texture(screen_tex, UV) * simptons;
	col.rgb *= 1.0 - pow(length(UV - 0.5) * 1.0, 0.9);
	//* .rgb / 0.01;
	COLOR = col;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_5yd65"]
shader = SubResource("Shader_5vw27")
shader_parameter/timescale = 0.0

[sub_resource type="GDScript" id="GDScript_y0s4v"]
script/source = "extends ColorRect

@export var timescale_gradient: Gradient;

func _process(_delta: float) -> void:
	self.color = timescale_gradient.sample(
		Timekeeper.timescale()
	)
	pass
"

