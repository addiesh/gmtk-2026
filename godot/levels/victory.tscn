[sub_resource type="Shader" id="Shader_w7j2h"]
code = "shader_type canvas_item;
uniform vec2 pan;
uniform sampler2D noise;

varying vec4 matoko;

void vertex() {
	matoko = COLOR;
}

void fragment() {
	vec2 uv = UV + pan + vec2(texture(noise, mod(UV + TIME / 16.0, 1.0)).r / 16.0, 0.0);
	COLOR = texture(TEXTURE, mod(uv, 1.0)) * matoko;
}
"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_bucei"]

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_mmwog"]
noise = SubResource("FastNoiseLite_bucei")
seamless = true

[sub_resource type="ShaderMaterial" id="ShaderMaterial_0qxk4"]
shader = SubResource("Shader_w7j2h")
shader_parameter/pan = Vector2(0, 0)
shader_parameter/noise = SubResource("NoiseTexture2D_mmwog")

[sub_resource type="GDScript" id="GDScript_xg568"]
script/source = "extends TextureRect

@onready var mat: ShaderMaterial = self.material; 

func _process(_delta: float) -> void:
	var cam = get_viewport().get_camera_2d();
	if cam == null:
		return;
	pass
	mat.set_shader_parameter(
		\"pan\",
		cam.global_position / get_viewport_rect().size / 4.0
	); 
	
"

