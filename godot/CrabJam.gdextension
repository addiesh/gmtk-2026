[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../rust/target/x86_64-unknown-linux-gnu/debug/libcrabjam.so"
linux.release.x86_64 =   "res://../rust/target/x86_64-unknown-linux-gnu/release/libcrabjam.so"
;windows.debug.x86_64 =   "res://../rust/target/debug/crabjam.dll"
;windows.release.x86_64 = "res://../rust/target/release/crabjam.dll"
web.debug.wasm32 =       "res://../rust/target/wasm32-unknown-emscripten/debug/crabjam.wasm"
web.release.wasm32 =     "res://../rust/target/wasm32-unknown-emscripten/release/crabjam.wasm"
