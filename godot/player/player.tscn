[sub_resource type="GDScript" id="GDScript_272bh"]
script/source = "extends Player

func _manually_spawn_ghost(t: Transform2D, tex: Texture2D) -> Sprite2D:
	return Ghost.make_ghost(t, tex)
"

[sub_resource type="Shader" id="Shader_w7j2h"]
code = "shader_type canvas_item;
uniform vec2 pan;

varying vec4 matoko;

void vertex() {
	matoko = COLOR;
}

void fragment() {
	COLOR = texture(TEXTURE, mod(UV + pan, 1.0)) * matoko;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fmu53"]
shader = SubResource("Shader_w7j2h")
shader_parameter/pan = Vector2(0, 0)

[sub_resource type="GDScript" id="GDScript_mmwog"]
script/source = "extends TextureRect

@onready var mat: ShaderMaterial = self.material; 

func _process(_delta: float) -> void:
	var cam = get_viewport().get_camera_2d();
	if cam == null:
		return;
	pass
	mat.set_shader_parameter(
		\"pan\",
		cam.global_position / get_viewport_rect().size
	); 
	
"

