[sub_resource type="GDScript" id="GDScript_j55il"]
script/source = "extends PanelContainer
@export var crabtime: CrabTimerManager;

func _process(_delta: float) -> void:
	if crabtime._remaining_time() <= 0.0:
		self.visible = true;
"

[sub_resource type="GDScript" id="GDScript_2qteb"]
script/source = "extends Node2D

@onready var step1 = $Step1;
@onready var step2 = $Step2;
@onready var dash = $Dash;
@onready var die = $Die;
@export var timerer: CrabTimerManager;

var freerf = false;
var has_died = false;

func _on_player_footstep() -> void:
	var pitchbend = randf_range(0.5, 1.5);
	if freerf:
		step1.pitch_scale = pitchbend;
		step1.play();
	else:
		step2.pitch_scale = pitchbend;
		step2.play();
	pass
	freerf = !freerf;


func _on_player_on_dash() -> void:
	dash.play();

func _process(_delta: float) -> void:
	if has_died:
		return
	if timerer._remaining_time() <= 0.0:
		has_died = true;
		die.play();
	
"

